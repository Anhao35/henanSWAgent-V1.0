# Spring Boot
SERVER_PORT=8088
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false

# 项目专用 MySQL / Redis
DB_URL=jdbc:mysql://127.0.0.1:13306/henan_sec_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=henan_agent
DB_PASSWORD=henan_agent_dev
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_PASSWORD=henan_redis_dev

# 首次启动管理员；上线前必须修改
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@123456
BOOTSTRAP_ADMIN_EMAIL=admin@henan-sec.local
REGISTRATION_REQUIRE_APPROVAL=true

# 开发邮件与密码重置
MAIL_HOST=127.0.0.1
MAIL_PORT=11025
MAIL_AUTH=false
MAIL_STARTTLS=false
PUBLIC_BASE_URL=http://localhost:5173
EXPOSE_RESET_TOKEN_IN_DEV=true

# 动态验证码：本地返回测试码；生产必须关闭并设置高强度随机密钥
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_CODE_RESEND_SECONDS=60
VERIFICATION_CODE_MAX_ATTEMPTS=5
EXPOSE_VERIFICATION_CODE_IN_DEV=true
VERIFICATION_CODE_SECRET=change-this-to-a-long-random-production-secret
# 手机短信采用通用 HTTP Webhook；对接阿里云/腾讯云等短信适配服务后填写
SMS_WEBHOOK_URL=
SMS_AUTH_TOKEN=

# MinIO
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_ACCESS_KEY=henan_minio
MINIO_SECRET_KEY=henan_minio_dev_password
MINIO_BUCKET=henan-sec-agent

# Dify 主 Agent
DIFY_BASE_URL=http://127.0.0.1:8081/v1
DIFY_API_KEY=app-xxxxxxxxxxxxxxxx
DIFY_TIMEOUT_SECONDS=1800
ASYNC_REQUEST_TIMEOUT_MS=1800000

# 资料检索：下列 Key 均为可选项，没有 Key 也可使用公开数据源
RESEARCH_TIMEOUT_SECONDS=12
RESEARCH_CACHE_MINUTES=30
# 建议填写联系邮箱以使用 Crossref polite pool，不是 API Key
CROSSREF_MAILTO=
# 免费注册且无需支付方式：https://openalex.org
OPENALEX_API_KEY=
# 免费申请：https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
# 当前网络能直接访问 openlibrary.org 时可启用；图书检索默认仍可使用 Crossref
OPEN_LIBRARY_ENABLED=false

# IOC 统一证据网关（仅使用查询接口；不提交报告、不上传样本）
EVIDENCE_TIMEOUT_SECONDS=15
ABUSEIPDB_MAX_AGE_DAYS=90
# 免费申请：https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=
# 一个 Auth-Key 可用于 ThreatFox / URLhaus / MalwareBazaar：https://auth.abuse.ch/
ABUSECH_AUTH_KEY=
# 免费申请：https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# 可选：https://viz.greynoise.io/signup
GREYNOISE_API_KEY=
# 可选：https://otx.alienvault.com/
OTX_API_KEY=

# Dify 知识库 API：在 Dify“知识库 -> API”页面生成；仅用于隔离试验库导入与评测
DIFY_DATASET_BASE_URL=http://127.0.0.1:8081/v1
DIFY_DATASET_API_KEY=
DIFY_RAG_PILOT_DATASET_ID=
RAG_SEMANTIC_TOP_K=8
RAG_KEYWORD_TOP_K=5
RAG_MAX_EXCERPTS=6
RAG_MAX_CONTEXT_CHARS=12000

# 自然语言到 MITRE ATT&CK / CWE 映射（密钥仅放在本机 .env，不要提交）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=180
DEEPSEEK_REQUESTS_PER_MINUTE=5
MITRE_MAPPING_CACHE_HOURS=24
DIFY_ROUTED_API_KEY=
