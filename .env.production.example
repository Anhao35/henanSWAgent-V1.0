# 复制为 .env.production；所有 CHANGE_ME 必须替换。不要提交真实密钥。
PUBLIC_ORIGIN=https://security.example.edu.cn
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=80
ATTACK_BRIDGE_BIND_ADDRESS=127.0.0.1
ATTACK_BRIDGE_PORT=8011
MINIO_CONSOLE_BIND_ADDRESS=127.0.0.1
MINIO_CONSOLE_PORT=19001

DB_PASSWORD=CHANGE_ME_LONG_RANDOM
MYSQL_ROOT_PASSWORD=CHANGE_ME_LONG_RANDOM
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM
MINIO_ACCESS_KEY=henan-sec-agent
MINIO_SECRET_KEY=CHANGE_ME_LONG_RANDOM
MINIO_BUCKET=henan-sec-agent
VERIFICATION_CODE_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
ATTACK_BRIDGE_API_KEY=CHANGE_ME_LONG_RANDOM

# 首次初始化时临时设为 true，创建管理员后立即改回 false。
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
REGISTRATION_REQUIRE_APPROVAL=true

# 生产 SMTP
MAIL_HOST=smtp.example.edu.cn
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_HEALTH_ENABLED=false

# 生产短信适配服务：接收 {phone, code, purpose, ttlMinutes}
SMS_WEBHOOK_URL=
SMS_AUTH_TOKEN=

# Dify 在宿主机 8081 发布时可使用默认值；否则改为实际内网地址。
DIFY_BASE_URL=http://host.docker.internal:8081/v1
DIFY_ROUTED_API_KEY=app-CHANGE_ME
DIFY_DATASET_BASE_URL=http://host.docker.internal:8081/v1
DIFY_DATASET_API_KEY=
DIFY_RAG_PILOT_DATASET_ID=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_MODEL=deepseek-v4-flash
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
ABUSEIPDB_API_KEY=
ABUSECH_AUTH_KEY=
NVD_API_KEY=
GREYNOISE_API_KEY=
OTX_API_KEY=

JAVA_OPTS=-Xms512m -Xmx2048m -Dfile.encoding=UTF-8
